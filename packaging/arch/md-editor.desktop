[Desktop Entry]
Type=Application
Name=MD Editor
GenericName=Markdown Editor
Comment=Local-first workspace for Markdown notes, PDFs and presentations
Exec=md-editor %F
Icon=md-editor
Terminal=false
MimeType=text/markdown;application/pdf;application/vnd.openxmlformats-officedocument.presentationml.presentation;inode/directory;
Categories=Office;TextEditor;Utility;
Keywords=markdown;notes;pdf;wiki;knowledge;
StartupWMClass=md-editor
